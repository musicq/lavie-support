{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "lavie-site",
  "pages_build_output_dir": "./site",
  "compatibility_date": "2026-06-24",
  // /api request counts, App Attest keys, users and their daily AI cost.
  // Secrets (`wrangler pages secret put`, then redeploy): DEEPSEEK_API_KEY, IP_SALT, DEVICECHECK_KEY.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lavie-proxy",
      "database_id": "2ce837df-c977-45e4-9a99-78291d5a01a8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APPLE_TEAM_ID": "QASBQ2U5K7",
    "BUNDLE_ID": "app.lifebar",
    "DEVICECHECK_KEY_ID": "3N7NL7YKLX",
    // "1" refuses requests that fail the check; "0" only logs them. Both passed on a real iPhone
    // (2.0 (33), 2026-10-13); either can be set back to "0" alone if Apple's service misbehaves.
    "ENFORCE_ATTEST": "1",
    "ENFORCE_DEVICE": "1",
    // Daily AI budget per person, in millionths of a dollar (50000 = $0.05).
    // The first statement of a day always fits.
    "CAP_PAID_MICRO": "50000",
    "CAP_TRIAL_MICRO": "20000",
    "CAP_FREE_MICRO": "50000",
    // Free statement imports per device per calendar month (the app allows one per payday cycle).
    "FREE_IMPORTS_PER_MONTH": "2",
    // Statement chunks per address (up to 9,000 characters each; a long statement is up to 14), and for everyone.
    "LIMIT_IP_HOUR": "40",
    "LIMIT_IP_DAY": "150",
    "LIMIT_ALL_DAY": "4000"
  }
}
